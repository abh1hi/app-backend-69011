rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Properties: Allow public read access so listings are visible.
    // Allow write only by the owner.
    match /properties/{userId}/{allPaths=**} {
      allow read;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // User Documents: STRICTLY restrict read and write to the owner.
    // No public access.
    match /user_documents/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
